<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- As when this was a single-file app: fit for a native (AOT) publish, and the build says so when it stops being.
         publish.ps1 publishes without it (-p:PublishAot=false), which needs no C++ build tools. -->
    <PublishAot>true</PublishAot>
    <!-- index.html and the settings are read from this folder, not copied next to the build. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests are their own project. -->
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
